---
import Layout from '../layouts/Layout.astro';
import GravityCalculator from '../components/GravityCalculator.astro';

const featuredPosts = [
  {
    title: "Black Holes: Where Gravity Becomes Extreme",
    description: "Explore the most extreme gravitational environments in the universe—black holes—where spacetime curvature becomes infinite and the laws of physics are tested.",
    slug: "black-holes-gravity-explained",
    date: "2024-01-25",
    readTime: "9 min read",
    image: "https://images.pexels.com/photos/73873/star-clusters-rosette-nebula-star-galaxies-73873.jpeg?auto=compress&cs=tinysrgb&w=1200",
    category: "Extreme Physics"
  },
  {
    title: "Gravitational Waves: The Historic Discovery That Changed Physics",
    description: "Learn about the groundbreaking 2015 detection of gravitational waves and why this discovery revolutionized our understanding of the universe.",
    slug: "gravitational-waves-discovery",
    date: "2024-01-20",
    readTime: "9 min read",
    image: "https://images.pexels.com/photos/2159/flight-sky-earth-space.jpg?auto=compress&cs=tinysrgb&w=800",
    category: "Discoveries"
  },
  {
    title: "Time Dilation: How Gravity Affects the Flow of Time",
    description: "Discover how gravity doesn't just bend space—it also warps time. Learn about gravitational time dilation and its surprising real-world effects.",
    slug: "time-dilation-gravity",
    date: "2024-01-28",
    readTime: "8 min read",
    image: "https://images.pexels.com/photos/7568783/pexels-photo-7568783.jpeg?auto=compress&cs=tinysrgb&w=800",
    category: "Theory"
  },
  {
    title: "Dark Matter and Gravity: The Universe's Hidden Mass",
    description: "Explore dark matter—mysterious invisible matter that makes up 85% of the universe's mass—and how we discovered it through its gravitational effects.",
    slug: "dark-matter-gravity",
    date: "2024-02-07",
    readTime: "9 min read",
    image: "https://images.pexels.com/photos/1252890/pexels-photo-1252890.jpeg?auto=compress&cs=tinysrgb&w=800",
    category: "Mysteries"
  }
];

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout
  title="InstaGrav"
  description="Your complete guide to understanding gravity, instant gravity, and gravitational phenomena. Explore the science, physics, and applications of one of nature's fundamental forces."
  keywords="gravity, instant gravity, gravitational force, physics, science, gravity explained, gravitational waves, spacetime"
>
  <div class="hero">
    <div class="hero-container">
      <h1 class="hero-title">
        <span class="gradient-text">InstaGrav<sup class="reg-mark">®</sup></span>
      </h1>
      <div class="tagline">Instant Gravity<sup class="tm-mark">™</sup></div>
      <p class="hero-subtitle">
        Your Complete Guide to Understanding Gravity and Instant Gravity
      </p>
      <p class="hero-description">
        Explore the fundamental force that shapes our universe, from Newton's apple to Einstein's spacetime curvature and beyond.
      </p>
    </div>
  </div>

  <GravityCalculator />

  <div class="search-section">
    <div class="search-container">
      <input
        type="search"
        id="search-input"
        placeholder="Search articles about gravity, instant gravity, black holes..."
        class="search-input"
      />
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </div>
    <div class="hero-cta">
      <a href="/blog" class="cta-button primary">Explore Articles</a>
      <a href="/about" class="cta-button secondary">Learn More</a>
    </div>
  </div>

  <section class="featured-posts">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Featured Articles</h2>
        <a href="/blog" class="view-all">View All Articles →</a>
      </div>
      <div class="posts-layout">
        <a href={`/blog/${featuredPosts[0].slug}`} class="hero-post">
          <div class="post-image" style={`background-image: url('${featuredPosts[0].image}')`}>
            <span class="post-category">{featuredPosts[0].category}</span>
          </div>
          <div class="post-content">
            <div class="post-meta">
              <span class="date">{formatDate(featuredPosts[0].date)}</span>
              <span class="divider">•</span>
              <span class="read-time">{featuredPosts[0].readTime}</span>
            </div>
            <h3>{featuredPosts[0].title}</h3>
            <p>{featuredPosts[0].description}</p>
          </div>
        </a>
        <div class="secondary-posts">
          {featuredPosts.slice(1).map(post => (
            <a href={`/blog/${post.slug}`} class="post-card">
              <div class="post-image-small" style={`background-image: url('${post.image}')`}>
                <span class="post-category">{post.category}</span>
              </div>
              <div class="post-content-small">
                <div class="post-meta">
                  <span class="date">{formatDate(post.date)}</span>
                  <span class="divider">•</span>
                  <span class="read-time">{post.readTime}</span>
                </div>
                <h4>{post.title}</h4>
                <p>{post.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="container">
      <div class="intro-content">
        <h2>What is Instant Gravity?</h2>
        <p>
          Instant gravity refers to the instantaneous nature of gravitational effects in classical physics,
          contrasted with Einstein's theory of relativity where gravitational changes propagate at the speed of light.
          This fascinating topic bridges classical and modern physics, offering insights into how we understand
          the universe's most fundamental force.
        </p>
        <p>
          At InstaGrav, we break down complex gravitational concepts into accessible, engaging content that
          helps you understand everything from basic gravity to advanced topics like gravitational waves,
          time dilation, and the nature of spacetime itself.
        </p>
        <a href="/blog" class="learn-more">Read Our Blog →</a>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('search-input');

    if (searchInput) {
      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          const searchTerm = searchInput.value.trim();
          if (searchTerm) {
            window.location.href = `/blog?search=${encodeURIComponent(searchTerm)}`;
          } else {
            window.location.href = '/blog';
          }
        }
      });
    }
  </script>
</Layout>

<style>
  .hero {
    background:
      linear-gradient(135deg, rgba(26, 26, 46, 0.95) 0%, rgba(22, 33, 62, 0.9) 50%, rgba(15, 15, 30, 0.95) 100%),
      url('https://images.pexels.com/photos/2150/sky-space-dark-galaxy.jpg?auto=compress&cs=tinysrgb&w=1920') center/cover;
    padding: 4rem 2rem 3rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 600px;
    height: 600px;
    background:
      radial-gradient(circle, rgba(79, 172, 254, 0.15) 0%, transparent 70%),
      url('https://images.pexels.com/photos/87651/earth-blue-planet-globe-planet-87651.jpeg?auto=compress&cs=tinysrgb&w=800') center/cover;
    border-radius: 50%;
    opacity: 0.3;
    pointer-events: none;
    animation: float 20s ease-in-out infinite;
  }


  @keyframes float {
    0%, 100% {
      transform: perspective(500px) rotateY(15deg) translateY(0) translateX(0);
    }
    50% {
      transform: perspective(500px) rotateY(15deg) translateY(-20px) translateX(10px);
    }
  }

  .hero-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: 4rem;
    margin: 0 0 0.5rem 0;
    font-weight: 800;
  }

  .reg-mark {
    font-size: 0.4em;
    font-weight: 600;
  }

  .tagline {
    font-size: 1.25rem;
    color: #00f2fe;
    margin: 0 0 1.5rem 0;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .tm-mark {
    font-size: 0.6em;
    font-weight: 600;
  }

  .gradient-text {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    color: #b0b0b0;
    font-weight: 600;
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #888;
    margin: 0;
  }

  .search-section {
    background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
    padding: 3rem 2rem;
    text-align: center;
  }

  .search-container {
    max-width: 600px;
    margin: 0 auto 2rem;
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 1rem 1rem 1rem 3rem;
    font-size: 1rem;
    border: 2px solid rgba(79, 172, 254, 0.3);
    border-radius: 12px;
    background: rgba(26, 26, 46, 0.8);
    color: #e0e0e0;
    transition: all 0.3s ease;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .search-input:focus {
    outline: none;
    border-color: #4facfe;
    background: rgba(26, 26, 46, 0.95);
    box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.1);
  }

  .search-input::placeholder {
    color: #666;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #4facfe;
    pointer-events: none;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .cta-button.primary {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: #0f0f1e;
  }

  .cta-button.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
  }

  .cta-button.secondary {
    background: transparent;
    border: 2px solid #4facfe;
    color: #4facfe;
  }

  .cta-button.secondary:hover {
    background: rgba(79, 172, 254, 0.1);
    transform: translateY(-2px);
  }

  .featured-posts {
    padding: 5rem 2rem;
    background: #0f0f1e;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    margin: 0;
    font-size: 2.5rem;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .view-all {
    color: #4facfe;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    transition: transform 0.3s ease;
  }

  .view-all:hover {
    transform: translateX(5px);
  }

  .posts-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
  }

  .hero-post {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(79, 172, 254, 0.15);
  }

  .hero-post:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(79, 172, 254, 0.25);
  }

  .post-image {
    height: 350px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .post-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(26, 26, 46, 0.7) 100%);
  }

  .post-category {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: #0f0f1e;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 1;
  }

  .post-content {
    padding: 2rem;
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .divider {
    color: #555;
  }

  .hero-post h3 {
    margin: 0 0 1rem 0;
    font-size: 1.875rem;
    line-height: 1.3;
    color: #ffffff;
  }

  .hero-post p {
    margin: 0;
    color: #b0b0b0;
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .secondary-posts {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(79, 172, 254, 0.15);
  }

  .post-card:hover {
    transform: translateX(5px);
    box-shadow: 0 10px 30px rgba(79, 172, 254, 0.2);
  }

  .post-image-small {
    width: 180px;
    min-height: 180px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .post-image-small::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.3) 0%, rgba(26, 26, 46, 0.6) 100%);
  }

  .post-image-small .post-category {
    top: 1rem;
    left: 1rem;
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }

  .post-content-small {
    padding: 1.5rem;
    flex: 1;
  }

  .post-card h4 {
    margin: 0 0 0.75rem 0;
    font-size: 1.25rem;
    line-height: 1.4;
    color: #ffffff;
  }

  .post-card p {
    margin: 0;
    color: #888;
    line-height: 1.6;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .intro {
    padding: 5rem 2rem;
    background: linear-gradient(135deg, #16213e 0%, #1a1a2e 100%);
  }

  .intro-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .intro-content h2 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem 0;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .intro-content p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #b0b0b0;
    margin: 0 0 1.5rem 0;
  }

  .learn-more {
    display: inline-block;
    color: #4facfe;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    transition: transform 0.3s ease;
  }

  .learn-more:hover {
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1rem 2rem 1rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .search-section {
      padding: 2rem 1rem;
    }

    .featured-posts {
      padding: 3rem 1rem;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .section-title {
      font-size: 2rem;
    }

    .posts-layout {
      grid-template-columns: 1fr;
    }

    .post-image {
      height: 250px;
    }

    .post-card {
      flex-direction: column;
    }

    .post-image-small {
      width: 100%;
      min-height: 200px;
    }

    .intro {
      padding: 3rem 1rem;
    }

    .intro-content h2 {
      font-size: 2rem;
    }
  }
</style>
