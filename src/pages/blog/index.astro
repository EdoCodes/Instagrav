function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout
  title="Blog - All Articles"
  description="Explore our comprehensive collection of articles about gravity, instant gravity, and gravitational phenomena. From basic concepts to advanced topics in physics."
  keywords="gravity blog, physics articles, gravity explained, instant gravity, gravitational physics"
>
  <div class="blog-header">
    <div class="container">
      <h1>InstaGrav Blog</h1>
      <p class="subtitle">Exploring Gravity and the Universe</p>
    </div>
  </div>

  <section class="blog-grid-section">
    <div class="container">
      <div id="no-results" class="no-results" style="display: none;">
        <p>No articles found matching your search. Try different keywords!</p>
      </div>
      <div class="blog-grid" id="blog-grid">
        {blogPosts.map(post => (
          <article class="blog-card" data-title={post.title.toLowerCase()} data-description={post.description.toLowerCase()}>
            <div class="blog-card-content">
              <div class="blog-meta">
                <span class="date">{formatDate(post.date)}</span>
                <span class="divider">•</span>
                <span class="read-time">{post.readTime}</span>
              </div>
              <h2>
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>
              <p>{post.description}</p>
              <a href={`/blog/${post.slug}`} class="read-more">
                Read Article →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const noResults = document.getElementById('no-results');
    const blogCards = document.querySelectorAll('.blog-card');

    // Check for search parameter in URL
    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');

    function filterArticles(searchTerm) {
      const term = searchTerm.toLowerCase().trim();
      let visibleCount = 0;

      blogCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';

        if (term === '' || title.includes(term) || description.includes(term)) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Apply search filter if parameter exists
    if (searchParam) {
      filterArticles(searchParam);
    }
  </script>
</Layout>

<style>
  .blog-header {
