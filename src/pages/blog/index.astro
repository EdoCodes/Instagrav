    padding: 5rem 2rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    top: -20%;
    right: 5%;
    width: 300px;
    height: 300px;
    background: url('https://images.pexels.com/photos/220201/pexels-photo-220201.jpeg?auto=compress&cs=tinysrgb&w=600') center/cover;
    border-radius: 50%;
    opacity: 0.15;
    pointer-events: none;
    animation: float 18s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-15px) rotate(5deg);
    }
  }

  .no-results {
    text-align: center;
    padding: 3rem 2rem;
    color: #888;
    font-size: 1.125rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .blog-header h1 {
    font-size: 3.5rem;
    margin: 0 0 1rem 0;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 1.5rem;
    color: #b0b0b0;
    margin: 0;
  }

  .blog-grid-section {
    padding: 4rem 0;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(79, 172, 254, 0.1);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(79, 172, 254, 0.2);
  }

  .blog-card-content {
    padding: 2rem;
  }

  .blog-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .divider {
    color: #555;
  }

  .blog-card h2 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .blog-card h2 a {
    color: #00f2fe;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .blog-card h2 a:hover {
    color: #4facfe;
  }

  .blog-card p {
    color: #b0b0b0;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .read-more {
    display: inline-block;
    color: #4facfe;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.3s ease;
  }

  .read-more:hover {
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .blog-header {
      padding: 3rem 1rem 2rem;
    }

    .blog-header h1 {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1.25rem;
    }

    .container {
      padding: 0 1rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .blog-card-content {
      padding: 1.5rem;
    }
  }
</style>
